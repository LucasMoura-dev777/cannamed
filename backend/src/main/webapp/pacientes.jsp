<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,java.net.*" %>
<%! String esc(String s){if(s==null)return "";return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} %>
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cannamed | Gerenciar pacientes</title><link rel="stylesheet" href="crud.css"></head><body><header><a href="index.html">CANNAMED</a><nav><a href="index.html">Início</a><a href="cadastro.html">Cadastrar paciente</a><a href="sair">Sair</a></nav></header><main><h1>Gerenciamento de pacientes</h1><p>Cadastre pela tela de cadastro; edite ou exclua registros abaixo.</p><% if(request.getParameter("msg")!=null){ %><p class="alert"><%=esc(request.getParameter("msg"))%></p><% } %><div class="grid">
<% for(String[] a:(List<String[]>)request.getAttribute("records")){ %><section class="card"><form method="post" action="pacientes"><input type="hidden" name="id" value="<%=esc(a[0])%>"><label>Nome<input name="nome" required value="<%=esc(a[1])%>"></label><label>E-mail<input name="email" type="email" required value="<%=esc(a[2])%>"></label><label>CPF<input name="cpf" required pattern="[0-9]{11}" maxlength="11" value="<%=esc(a[3])%>"></label><label>Nascimento<input type="date" name="dataNascimento" required value="<%=esc(a[4])%>"></label><button name="acao" value="editar">Salvar alterações</button><button name="acao" value="excluir" class="danger" formnovalidate onclick="return confirm('Excluir este paciente?')">Excluir paciente</button></form></section><% } %></div></main></body></html>
